@model IEnumerable<ContactModel>
@{
    ViewData["Title"] = "Contact Info";
    Paginate pager = new Paginate();
    int pageNo = 0;
    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<h1>Danh Sách Liên Hệ</h1>
<table class="table" id="productTable">
    <thead>
        <tr>
            <th scope="col">STT</th>
            <th scope="col">Tên</th>
            <th scope="col">Mô tả</th>
            <th scope="col">Số điện thoại</th>
            <th scope="col">Map</th>
            <th scope="col">Email</th>
            <th scope="col">Logo</th>
            <th scope="col">Tuỳ chọn</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1; // Khởi tạo biến đếm bằng 1 trước khi vào vòng lặp
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@i</td>
                <td>@item.Name</td>
                <td>@Html.Raw(@item.Description)</td>
                <td>@item.Phone</td>
                <td>@Html.Raw(@item.Map)</td>
                <td>@item.Email</td>
                <td><img src="~/media/logo/@item.LogoImg" width="120" height="150"></td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Contact">Sửa</a>
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>
<partial name="_Paging" model="@pager" />
@section Scripts {
    <script>
        let table = new DataTable('#productTable', {
            layout: {
                topStart: {
                    buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
                }
            }
        });
    </script>
}